{
  "AWSEBDockerrunVersion": "1",
  "Image": {
    "Name": "%DOCKER_IMAGE%",
    "Update": "true"
  },
  "Ports": [
    {
      "ContainerPort": 3000,
      "HostPort": 80
    }
  ],
  "Volumes": [
    {
      "HostDirectory": "/var/app/data",
      "ContainerDirectory": "/app/data"
    }
  ],
  "Logging": "/var/log/nginx"
}
